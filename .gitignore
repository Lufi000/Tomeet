.DS_Store
xcuserdata/
build/
DerivedData/
*.xcuserstate

# 图书文件：版权书（books/Copyrighte_books/）与讲书音频一律不进仓库
*.epub
*.mp3
*.mp4
*.MP4

# 例外：Gutenberg 公版书随仓库分发
!books/public_domain_books/**/*.epub

# API 密钥（本地私有，模板见 Secrets.swift.template）
Secrets.swift

# BFF env (secrets, template in bff/.env.example)
bff/.env
.deriveddata/

# Claude Code / MCP 本地配置
.claude/settings.local.json
.mcp.json

# superpowers 的临时工作区（ledger / task brief / 审查包 / 截图）—— 不是产物。
# 它自带一个 .gitignore，但那是一行 `*` 的自忽略，删掉它整棵树就会冒出来；
# 这里再钉一条，免得依赖那个文件在不在。
.superpowers/sdd/

# Obsidian 仓库笔记：个人写作状态与待办草稿，不进仓库（docs/ 里的正式文档照常跟踪）
.obsidian/
docs/todo/
